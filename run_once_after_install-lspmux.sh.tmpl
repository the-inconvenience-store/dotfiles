{{- if eq .chezmoi.os "linux" -}}
#!/bin/sh
set -eu

required_version="0.3.0"

if command -v lspmux >/dev/null 2>&1 && lspmux --version 2>/dev/null | grep -q "lspmux $required_version"; then
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    if command -v rustup >/dev/null 2>&1; then
        rustup toolchain install stable --profile minimal
        rustup default stable
    else
        if ! command -v curl >/dev/null 2>&1; then
            printf '%s\n' 'curl is required to install Rust before installing lspmux.' >&2
            exit 1
        fi
        tmp=$(mktemp)
        trap 'rm -f "$tmp"' EXIT
        curl --fail --silent --show-error --location https://sh.rustup.rs -o "$tmp"
        sh "$tmp" -y --profile minimal --default-toolchain stable
        export PATH="$HOME/.cargo/bin:$PATH"
    fi
fi

cargo install lspmux --version "$required_version" --locked
{{- end -}}
