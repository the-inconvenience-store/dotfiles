{{- if eq .chezmoi.os "darwin" -}}
{{- $server := eq (index . "profile" | default "workstation") "server" -}}
{{- $brews := .packages.darwin.brews -}}
{{- if $server -}}
{{- $brews = .packages.server.darwin.brews -}}
{{- end -}}
#!/bin/bash
set -euo pipefail

if ! command -v brew >/dev/null 2>&1; then
    printf '%s\n' 'Homebrew is not available after the Homebrew bootstrap script.' >&2
    exit 1
fi

brew bundle --file=/dev/stdin <<'EOF'
{{- range $brews }}
brew "{{ . }}"
{{- end }}
{{- if not $server }}
{{- range .packages.darwin.casks }}
cask "{{ . }}"
{{- end }}
{{- end }}
EOF
{{ if not $server }}
# Yazi's full media dependencies are keg-only; expose their tools on PATH.
brew link ffmpeg-full imagemagick-full --force --overwrite
{{- end }}
{{- end }}
